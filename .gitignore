# Competition data: login-gated, never commit
data/*
!data/README.md
!data/.gitkeep

# Scratch and caches
__pycache__/
*.pyc
.pytest_cache/
.venv/
.venv-*/
*.egg-info/
/tmp/
*.npy
*.npz
*.log

# Large intermediates (keep out of Git)
scratch/
runs/

